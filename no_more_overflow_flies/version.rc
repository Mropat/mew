#include <winver.h>

// Version metadata. A DLL with no description, product or company looks
// anonymous to reputation heuristics, which is part of why a freshly built
// unsigned mod gets flagged. This does not make it trusted - only signing
// does - but it stops it being blank.

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Mropat"
            VALUE "FileDescription",  "Fills in spawn HP so mid-turn spawns cannot be misread"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "no_more_overflow_flies"
            VALUE "OriginalFilename", "no_more_overflow_flies.dll"
            VALUE "ProductName",      "mew - Mewgenics mods"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "Comments",         "Open source: https://github.com/Mropat/mew"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
